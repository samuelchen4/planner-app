{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "local": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "local"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "dev": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "dev"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "dev": {},
    "production": {}
  }
}
